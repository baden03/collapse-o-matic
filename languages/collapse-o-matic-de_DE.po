msgstr "Tabindex-Attribut"

#. translators: %1$s: opening link tag, %2$s: closing link tag.
#: collapse-o-matic.php:674
#, php-format
msgid ""
"Default tabindex value to be assigned to the trigger element. See "
"%1$sTabindex Attribute%2$s in the documentation for more info."
msgstr ""
"Standard-Tabindex-Wert für das Trigger-Element. Weitere Informationen "
"finden Sie in der Dokumentation unter %1$sTabindex-Attribut%2$s."

#: collapse-o-matic.php:681
msgid "Targtag Attribute"
msgstr "Targtag-Attribut"

