#: collapse-o-matic.php:703 collapse-o-matic.php:704
msgid "No Title"
msgstr "Kein Titel"

#: collapse-o-matic.php:705
msgid "Do not use title tags by default."
msgstr "Standardmäßig keine title-Tags verwenden."

#: collapse-o-matic.php:710 collapse-o-matic.php:711
msgid "Add touchstart"
msgstr "Touchstart hinzufügen"

#: collapse-o-matic.php:712
msgid "Add jQuery touchstart binding to triggers."
msgstr "jQuery-Touchstart-Bindung für Trigger hinzufügen."

#: collapse-o-matic.php:717
msgid "Initial Pause"
msgstr "Anfängliche Pause"

#: collapse-o-matic.php:719
